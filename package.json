		"@fontsource/barlow-condensed": "^5.3.0",
		"@fontsource/inter": "^5.3.0",
		"@fontsource/noto-sans-jp": "^5.3.1",
		"astro": "^7.4.12",
		"fontkit": "^3.0.0",
		"mdast-util-from-markdown": "^2.0.2",
		"parse5": "^8.1.1",
		"satori": "^0.63.2",
