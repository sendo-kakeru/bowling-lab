{
	"compilerOptions": {
		"erasableSyntaxOnly": true,
		"noUncheckedIndexedAccess": true,
		"strictNullChecks": true
	},
	"contentMappers": [
		{
			"extensions": [".astro"],
			"package": "@astrojs/ts-content-mapper"
		}
	],
	"exclude": ["dist"],
	"extends": "astro/tsconfigs/strict",
	"include": [".astro/types.d.ts", ".storybook/**/*", "**/*"]
}
