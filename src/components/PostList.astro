---
import type { Post } from "../lib/get-posts";
import Breadcrumb from "./Breadcrumb.astro";
import Pagination from "./Pagination.astro";
import PostCard from "./PostCard.astro";

/*
  記事一覧の中身（パンくず、見出し、記事のカード、ページ送り）。1 ページ目と 2 ページ目以降で共有する
*/

interface Props {
	posts: readonly Post[];
	/** 今のページ（1 始まり） */
	current: number;
	pageCount: number;
}

const { posts, current, pageCount } = Astro.props;
---

<div class="posts-page">
	<Breadcrumb items={[{ href: "/", label: "HOME" }, { label: "POSTS" }]} />

	<!-- 記事のカードと見分けがつくよう、見出しはカードに載せずレーンに直接置く -->
	<h1 class="text-page-title">POSTS</h1>

	{posts.length > 0 ? (
		<ol class="list">
			{posts.map((post, index) => (
				<li>
					<PostCard post={post} priority={current === 1 && index === 0} />
				</li>
			))}
		</ol>
	) : (
		<p class="empty">まだ記事はありません。</p>
	)}

	<Pagination
		basePath="/posts"
		class="pagination"
		current={current}
		pageCount={pageCount}
	/>
</div>

<style>
.posts-page {
	display: grid;
	row-gap: 0.75rem;
}

.list {
	display: grid;
	row-gap: 0.75rem;
	margin-top: 0.5rem;
	padding: 0;
	list-style: none;
}

/* MemoList の空の表示と同じ */
.empty {
	margin-top: 0.5rem;
	color: var(--color-ink-900);
	font-size: var(--font-size-14);
	line-height: 1.7;
}

/* デザインではカードの列より少し離すので、行の間隔に足す */
.pagination {
	justify-self: center;
	margin-top: 0.75rem;
}

@media (width >= 768px) {
	.posts-page {
		row-gap: 1rem;
	}

	/* 大文字だけの見出しは行の箱の下が空くので、見た目の間隔がパンくずとの間より広くならないよう控えめにする */
	.list {
		row-gap: 1rem;
	}
}
</style>
