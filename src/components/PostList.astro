---
import type { Post } from "../utils/get-posts";
import Breadcrumb from "./Breadcrumb.astro";
import Pagination from "./Pagination.astro";
import PostCard from "./PostCard.astro";

/*
  記事一覧の中身（パンくず、見出し、記事のカード、ページ送り）。1 ページ目と 2 ページ目以降で共有する
*/

interface Props {
	posts: readonly Post[];
	/** 今のページ（1 始まり） */
	current: number;
	pageCount: number;
}

const { posts, current, pageCount } = Astro.props;
---

<div class="posts-page">
	<Breadcrumb items={[{ href: "/", label: "HOME" }, { label: "POSTS" }]} />

	<!-- 記事のカードと見分けがつくよう、見出しはカードに載せずレーンに直接置く -->
	<h1 class="title">ALL POSTS</h1>

	<ol class="list">
		{posts.map((post, index) => (
			<li>
				<PostCard post={post} priority={current === 1 && index === 0} />
			</li>
		))}
	</ol>

	<Pagination
		basePath="/posts"
		class="pagination"
		current={current}
		pageCount={pageCount}
	/>
</div>

<style>
.posts-page {
	display: grid;
	row-gap: 0.75rem;
}

.title {
	padding-top: 0.5rem;
	color: var(--color-navy-900);
	font-family: var(--font-display);
	font-size: var(--font-size-40);
	/* 細い書体なので、この大きさでは 700 だと線が細く見える */
	font-weight: 800;
	letter-spacing: 0.02em;
	line-height: 1;
}

.list {
	display: grid;
	row-gap: 0.75rem;
	margin-top: 0.5rem;
	padding: 0;
	list-style: none;
}

/* デザインではカードの列より少し離すので、行の間隔に足す */
.pagination {
	justify-self: center;
	margin-top: 0.75rem;
}

@media (width >= 768px) {
	.posts-page {
		row-gap: 1rem;
	}

	.title {
		font-size: var(--font-size-56);
	}

	/* 大文字だけの見出しは行の箱の下が空くので、見た目の間隔がパンくずとの間より広くならないよう控えめにする */
	.list {
		row-gap: 1rem;
	}
}
</style>
