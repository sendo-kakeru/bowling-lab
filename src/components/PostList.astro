---
import type { HTMLAttributes } from "astro/types";
import type { Post } from "../utils/get-posts";
import PostCard from "./PostCard.astro";

interface Props extends HTMLAttributes<"ul"> {
	posts: readonly Post[];
	headingLevel: 2 | 3;
}

const { posts, headingLevel, class: className, ...rest } = Astro.props;
---

<ul {...rest} class:list={["list", className]}>
	{posts.map((post) => (
		<li>
			<PostCard headingLevel={headingLevel} post={post} />
		</li>
	))}
</ul>

<style>
.list {
	display: grid;
	row-gap: 2rem;
	margin: 0;
	padding: 0;
	list-style: none;
}
</style>
