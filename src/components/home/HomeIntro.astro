---
import type { HTMLAttributes } from "astro/types";
import { SITE_TAGLINE, SITE_TITLE } from "../../consts";
import Card from "../Card.astro";
import Spats from "../Spats.astro";

/*
  ホームのサイト説明。初めて来た人に何のサイトかを伝える。ページの見出し（h1）はここが持つ
*/

type Props = HTMLAttributes<"div">;

const { class: className, ...rest } = Astro.props;
---

<Card {...rest} class:list={["home-intro", className]}>
	<Spats size="small" />
	<h1 class="title">{SITE_TITLE}</h1>
	<p class="tagline">{SITE_TAGLINE}</p>
</Card>

<style>
.home-intro {
	display: grid;
	justify-items: center;
	row-gap: 1rem;
	padding: 1.5rem 1.25rem;
	text-align: center;
}

/* スパットは飾りなので、サイト名とタグラインのまとまりから少し離す */
.title {
	margin-block-start: 0.25rem;
	color: var(--color-navy-900);
	font-family: var(--font-display);
	font-size: var(--font-size-28);
	font-weight: 700;
	letter-spacing: 0.04em;
	line-height: 1.1;
	text-transform: uppercase;
	text-wrap: balance;
}

.tagline {
	max-inline-size: 36em;
	color: var(--color-ink-700);
	font-size: var(--font-size-14);
	line-height: 1.75;
	text-wrap: balance;
	word-break: auto-phrase;
}

@media (width >= 768px) {
	.home-intro {
		padding: 2rem 2.5rem;
	}

	.title {
		font-size: var(--font-size-44);
	}

	.tagline {
		font-size: var(--font-size-15);
		line-height: 1.8;
	}
}
</style>
