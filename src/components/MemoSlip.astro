---
import type { HTMLAttributes } from "astro/types";
import type { Memo } from "../lib/content/memo-schema";
import { formatDotDate, formatTime } from "../lib/date";

/*
  メモ 1 件の伝票。上に最初の書き込みの日時、点線の下にその本文。
  記事のカード（Card）より角を小さくして、紙の伝票に見せる。
  続きの書き込みがあれば、閉じているあいだはメモ帳のように紙を後ろに重ね、
  開くと続きを下に 1 枚ずつ並べる。
  ピン留めしたメモは、上の縁の中央に画鋲を刺す。
*/

interface Props extends HTMLAttributes<"article"> {
	memo: Memo;
}

const { memo, class: className, ...rest } = Astro.props;

/** 後ろに重ねる紙の上限。続きがこれより多くても、紙の数はここで止める */
const MAX_SHEETS = 3;

const [first, ...replies] = memo.notes;
---

<article
	{...rest}
	data-sheets={replies.length > 0
		? Math.min(replies.length, MAX_SHEETS)
		: undefined}
	class:list={["slip", className]}
>
	{memo.pinned && (
			<span class="sr-only">ピン留め</span>
			<svg aria-hidden="true" class="pin" viewBox="0 0 24 44">
				<line class="pin-needle" x1="12" x2="12" y1="28" y2="44" />
				<ellipse class="pin-base" cx="12" cy="26.5" rx="8.5" ry="2.4" />
				<path class="pin-body" d="M8.2 9.5 9.6 25h4.8l1.4-15.5z" />
				<path class="pin-gloss-line" d="M9.4 10.5 10.6 24" />
				<rect class="pin-head" height="7" rx="3.5" width="17" x="3.5" y="3" />
				<rect
					class="pin-gloss"
					height="1.6"
					rx="0.8"
					width="8"
					x="5.5"
					y="4.2"
				/>
			</svg>
	)}
	<time class="meta" datetime={first.postedAt.toISOString()}>
		<span>{formatDotDate({ date: first.postedAt })}</span>
		<span>{formatTime({ date: first.postedAt })}</span>
	</time>
	<div class="prose text" set:html={first.html} />
	{replies.length > 0 && (
		<details class="thread">
			<summary class="toggle">
				<!-- 名前は見える文字から始める（音声操作で「THREAD」と呼べるように）。中黒は読ませない -->
				<span>
					THREAD <span aria-hidden="true">·</span> {replies.length}
				</span>
				<span class="sr-only">（続きの書き込み）</span>
				<span aria-hidden="true" class="caret" />
			</summary>
			<ol class="replies">
				{replies.map((reply) => (
					<li class="reply">
						<time class="meta" datetime={reply.postedAt.toISOString()}>
							<span>{formatDotDate({ date: reply.postedAt })}</span>
							<span>{formatTime({ date: reply.postedAt })}</span>
						</time>
						<div class="prose text" set:html={reply.html} />
					</li>
				))}
			</ol>
		</details>
	)}
</article>

<style>
.slip {
	position: relative;
	display: grid;
	grid-template-columns: minmax(0, 1fr);
	align-content: start;
	row-gap: 0.5rem;
	padding: 0.75rem 1rem 1rem;
	border-radius: var(--radius-4);
	background: var(--color-card);
	box-shadow: var(--shadow-card);
}

/* 後ろに重ねる紙。続きの件数と同じ枚数で、3 件以上は 3 枚。奥ほど少し濃い */
.slip[data-sheets="1"]:not(:has(.thread[open])) {
	box-shadow:
		var(--shadow-card),
		5px 5px 0 var(--color-wood-50),
		5px 5px 0 1px var(--color-wood-200);
}

.slip[data-sheets="2"]:not(:has(.thread[open])) {
	box-shadow:
		var(--shadow-card),
		5px 5px 0 var(--color-wood-50),
		5px 5px 0 1px var(--color-wood-200),
		10px 10px 0 var(--color-wood-150),
		10px 10px 0 1px var(--color-wood-200);
}

.slip[data-sheets="3"]:not(:has(.thread[open])) {
	box-shadow:
		var(--shadow-card),
		5px 5px 0 var(--color-wood-50),
		5px 5px 0 1px var(--color-wood-200),
		10px 10px 0 var(--color-wood-150),
		10px 10px 0 1px var(--color-wood-200),
		15px 15px 0 var(--color-wood-200),
		15px 15px 0 1px var(--color-wood-300);
}

/* 押して開ける（続きがあり、閉じている）伝票だけ、記事のカードと同じく地の色を変える。
	   タッチ端末でホバーが残らないように。動きを減らす設定ではリセット（base.css）が止める */
@media (hover: hover) {
	/* 下の .slip の box-shadow の transition より詳細度が高いので、ここにも書く */
	.slip:has(.thread) {
		transition:
			background-color 0.15s,
			box-shadow 0.25s;
	}

	.slip:has(.thread:not([open])):hover {
		background: var(--color-chip);
	}
}

/* 横から見た押しピンを、上の縁の中央に右へ傾けて刺す。針の先（下端の中央）を軸に回し、縁から 6px 下に刺さったように置く。
   影を離して落とし、紙から立っているように見せる。
   閉じた伝票を開くための覆いより上に出し、押しても覆いへ通す */
.pin {
	position: absolute;
	top: calc(0.375rem - 2.25rem);
	left: 50%;
	z-index: 1;
	height: 2.25rem;
	aspect-ratio: 24 / 44;
	overflow: visible;
	color: var(--color-red);
	filter: drop-shadow(
		7px 6px 2.5px color-mix(in srgb, var(--color-shadow) 28%, transparent)
	);
	translate: -50% 0;
	rotate: 18deg;
	transform-origin: 50% 100%;
	pointer-events: none;
}

.pin-needle {
	stroke: color-mix(in srgb, var(--color-gutter) 40%, white);
	stroke-width: 1.6;
	stroke-linecap: round;
}

.pin-base {
	fill: color-mix(in srgb, currentColor 70%, black);
}

.pin-body {
	fill: color-mix(in srgb, currentColor 85%, black);
}

.pin-head {
	fill: currentColor;
}

.pin-gloss-line {
	fill: none;
	stroke: color-mix(in srgb, white 35%, transparent);
	stroke-width: 1;
	stroke-linecap: round;
}

.pin-gloss {
	fill: color-mix(in srgb, white 45%, transparent);
}

.meta {
	display: grid;
	grid-template-columns: auto auto;
	justify-content: space-between;
	padding-bottom: 0.5rem;
	border-bottom: 1px dashed var(--color-wood-300);
	color: var(--color-ink-600);
	font-family: var(--font-display);
	font-size: var(--font-size-13);
	font-weight: 600;
	letter-spacing: 0.08em;
	line-height: 1.4;
}

/* 本文の大きさと行間は .prose の中の要素へ継承させる（.prose は大きさを持たない） */
.text {
	color: var(--color-ink-900);
	font-size: var(--font-size-15);
	line-height: 1.8;
}

.thread {
	display: grid;
	grid-template-columns: minmax(0, 1fr);
}

.toggle {
	display: grid;
	grid-auto-flow: column;
	align-items: center;
	justify-content: start;
	column-gap: 0.5rem;
	/* 指で押しやすいよう、見た目の行より上下に広げる */
	padding-block: 0.5rem;
	color: var(--color-link);
	font-family: var(--font-display);
	font-size: var(--font-size-14);
	font-weight: 700;
	letter-spacing: 0.1em;
	line-height: 1.2;
	cursor: pointer;
	list-style: none;
}

.toggle::-webkit-details-marker {
	display: none;
}

/* 閉じているあいだは伝票のどこを押しても開く。開いたら本文を選べるよう外す */
.thread:not([open]) > .toggle::after {
	content: "";
	position: absolute;
	inset: 0;
	border-radius: inherit;
}

/* 最初の書き込みはアコーディオンの外で常に見えているので、その中で操作するもの（リンク、動画、埋め込み、横スクロール）は閉じているあいだも覆いより上に出す */
.text :global(:is(a, video, iframe, pre, .table-scroll)) {
	position: relative;
	z-index: 1;
}

.caret {
	width: 0.625rem;
	aspect-ratio: 2 / 1;
	background: currentColor;
	clip-path: polygon(0 0, 100% 0, 50% 100%);
}

.thread[open] .caret {
	rotate: 180deg;
}

/* 続きは閉じていたときに後ろに重ねていた紙。左の糸で最初の書き込みとつなぐ */
.replies {
	display: grid;
	grid-template-columns: minmax(0, 1fr);
	row-gap: 0.5rem;
	padding: 0.25rem 0 0 0.75rem;
	border-left: 2px solid var(--color-wood-200);
	list-style: none;
}

.reply {
	display: grid;
	grid-template-columns: minmax(0, 1fr);
	row-gap: 0.5rem;
	padding: 0.75rem;
	border-radius: var(--radius-4);
	background: var(--color-wood-50);
	box-shadow: 0 1px 0 var(--color-wood-200);
}

@media (prefers-reduced-motion: no-preference) {
	.slip {
		transition: box-shadow 0.25s;
	}

	.caret {
		transition: rotate 0.15s;
	}

	/* interpolate-size がないブラウザでは動きなしで開く */
	.thread {
		interpolate-size: allow-keywords;
	}

	.thread::details-content {
		block-size: 0;
		overflow: clip;
		transition:
			block-size 0.25s,
			content-visibility 0.25s allow-discrete;
	}

	.thread[open]::details-content {
		block-size: auto;
	}
}

/* 強制カラーモードでは背景と影が消えるので、枠で紙の形を残す */
@media (forced-colors: active) {
	.reply {
		border: 1px solid;
	}

	/* 影が消え、赤も保証されないので、押しピンを文字の色の 1 色で描く */
	.pin {
		forced-color-adjust: none;
		color: CanvasText;
		filter: none;
	}

	.pin * {
		fill: currentColor;
		stroke: currentColor;
	}

	.pin-gloss-line,
	.pin-gloss {
		display: none;
	}
}
</style>
