---
import type { HTMLAttributes } from "astro/types";
import type { Post } from "../lib/content/get-posts";
import { formatDotDate, formatIsoDate } from "../lib/date";
import { getThumbnailImage } from "../lib/media/thumbnail";
import Card from "./Card.astro";

/*
  記事一覧とホームの記事カード。左に画像、右にタイトルと公開日（768px 以上は抜粋も）。
  layout="tile" はホーム用で、768px 以上は画像を上に置いた縦長のタイルにし、抜粋は出さない。
  カード全体を押せるよう、リンクは見出しの <a> に置いて ::after でカードの面に広げる
  （カードを <a> で包むと、見出しも抜粋も日付もリンク名として読み上げられる）。
  サムネイルは隣にタイトルがあるので alt を空にする
*/

interface Props extends HTMLAttributes<"article"> {
	post: Post;
	/** タイトルの見出しの階層。ページの見出しの 1 つ下にする */
	headingLevel?: 2 | 3;
	/** 画像を遅延読み込みしない。最初の画面に入る一番大きな画像に使う */
	priority?: boolean;
	layout?: "row" | "tile";
}

const {
	post,
	headingLevel = 2,
	priority = false,
	layout = "row",
	class: className,
	...rest
} = Astro.props;

const Heading = `h${headingLevel}` as const;
const image = getThumbnailImage({
	slug: post.slug,
	thumbnail: post.thumbnail,
});
const imgAttributes = {
	decoding: "async",
	fetchpriority: priority ? "high" : undefined,
	loading: priority ? "eager" : "lazy",
} as const;
---

<Card
	{...rest}
	as="article"
	data-layout={layout}
	class:list={["post-card", className]}
>
	<div class="thumb">
		{/* 768px を境に枠の縦横比が変わり切り抜きも替わる（アートディレクション）。srcset / sizes では比率を替えられないので <picture> にする。
		    切り抜きの大きさは枠ごとに 1 つ（thumbnail.ts の THUMBNAIL_CROPS） */}
		{image.kind === "crops" ? (
			<picture>
				<source
					height={image.crops[layout].height}
					media="(width >= 768px)"
					srcset={image.crops[layout].src}
					width={image.crops[layout].width}
				>
				<img
					{...imgAttributes}
					alt=""
					height={image.crops.square.height}
					src={image.crops.square.src}
					width={image.crops.square.width}
				>
			</picture>
		) : (
			<img
				{...imgAttributes}
				alt=""
				height={image.height}
				src={image.src}
				width={image.width}
			>
		)}
	</div>
	<div class="body">
		<Heading class="title">
			<a class="link" href={`/posts/${post.slug}`}>{post.title}</a>
		</Heading>
		{layout === "row" && post.description && (
			<p class="excerpt">{post.description}</p>
		)}
		<time
			class="date text-meta"
			datetime={formatIsoDate({ date: post.publishedAt })}
		>
			{formatDotDate({ date: post.publishedAt })}
		</time>
	</div>
</Card>

<style>
.post-card {
	position: relative;
	display: grid;
	grid-template-columns: 6rem minmax(0, 1fr);
	align-items: start;
	column-gap: 0.75rem;
	padding: var(--card-padding);
}

.thumb {
	overflow: hidden;
	height: 6rem;
	border-radius: var(--radius-6);
	background: var(--color-wood-100);
}

/* <picture> の箱を消し、<img> の 100% を .thumb の大きさにする */
.thumb picture {
	display: contents;
}

.thumb img {
	width: 100%;
	height: 100%;
	object-fit: cover;
	transition: scale 0.3s;
}

.body {
	display: grid;
	row-gap: 0.25rem;
}

.title {
	font-size: var(--font-size-16);
	font-weight: 700;
	line-height: 1.45;
}

.link {
	color: var(--color-ink-900);
	text-decoration: none;
}

.link::after {
	position: absolute;
	inset: 0;
	border-radius: inherit;
	content: "";
}

/* タッチ端末でホバーが残らないように。動きを減らす設定ではリセット（base.css）が止める */
@media (hover: hover) {
	.post-card {
		transition: background-color 0.15s;
	}

	.post-card:hover {
		background: var(--color-chip);
	}

	.post-card:hover .thumb img {
		scale: 1.05;
	}
}

.excerpt {
	display: none;
	color: var(--color-ink-700);
	font-size: var(--font-size-14);
	line-height: 1.7;
}

.date {
	color: var(--color-ink-600);
}

@media (width >= 768px) {
	/* 横に広いカードでは --card-padding だと画像が縁に詰まって見えるので広げる。角丸は同心円からずれるが、この大きさでは目立たない */
	.post-card {
		grid-template-columns: 12.5rem minmax(0, 1fr);
		align-items: center;
		column-gap: 1.5rem;
		padding: 1rem;
	}

	.thumb {
		height: 7.5rem;
	}

	.title {
		font-size: var(--font-size-19);
	}

	.excerpt {
		display: block;
	}

	.post-card[data-layout="tile"] {
		grid-template-columns: minmax(0, 1fr);
		/* 同じ段の高いカードに合わせて伸びた分は、画像と文字の間ではなくカードの下に空ける */
		align-content: start;
		align-items: start;
		/* 縦長の面では --card-padding だと画像が縁に詰まって見えるので広げる。
		   角を同心円にそろえるため、画像の角丸を減らした分だけ余白を足す（16px = 4px + 12px） */
		padding: 0.75rem;
	}

	[data-layout="tile"] .thumb {
		height: 10rem;
		border-radius: var(--radius-4);
	}

	/* 文字の左右は画像の端にそろえる */
	[data-layout="tile"] .body {
		padding: 1rem 0 0.5rem;
	}

	[data-layout="tile"] .title {
		font-size: var(--font-size-17);
	}
}
</style>
