---
import type { HTMLAttributes } from "astro/types";
import { NAV_ITEMS, SITE_TITLE } from "../consts";

type Props = HTMLAttributes<"header">;

const { class: className, ...rest } = Astro.props;

const { pathname } = Astro.url;

/**
 * リンク先そのものにいるなら "page"、その配下（/posts/page/2 や /posts/<スラッグ>）にいるなら "true"。
 * 配下で "page" にすると、別のページへのリンクを「現在のページ」と読み上げてしまう
 */
function getAriaCurrent({
	href,
}: {
	href: string;
}): "page" | "true" | undefined {
	if (pathname === href) return "page";
	if (pathname.startsWith(`${href}/`)) return "true";
	return undefined;
}
---

<header {...rest} class:list={["header", className]}>
	<a class="title" href="/">{SITE_TITLE}</a>
	<nav aria-label="メインメニュー">
		<ul class="nav-list">
			{NAV_ITEMS.map(({ href, label }) => (
				<li>
					<a aria-current={getAriaCurrent({ href })} href={href}>
						{label}
					</a>
				</li>
			))}
		</ul>
	</nav>
</header>

<style>
.header {
	display: grid;
	grid-template-columns: auto auto;
	justify-content: space-between;
	align-items: center;
	column-gap: 1rem;
	padding: 0.75rem 1rem;
	border-bottom: 1px solid;
}

.title {
	font-weight: 700;
}

.nav-list {
	display: grid;
	grid-auto-flow: column;
	column-gap: 1rem;
	margin: 0;
	padding: 0;
	list-style: none;
}

[aria-current] {
	font-weight: 700;
}
</style>
