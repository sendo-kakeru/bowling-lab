---
import type { Memo } from "../lib/memo-schema";
import type { Page } from "../lib/pagination";
import Breadcrumb from "./Breadcrumb.astro";
import MemoSlip from "./MemoSlip.astro";
import Pagination from "./Pagination.astro";

/*
  メモ一覧のページの中身（パンくず、見出し、伝票、ページ送り）。1 ページ目と 2 ページ目以降で共有する。
  スマホは 1 列、768px 以上は 2 列。日付は伝票ごとに載っているので、日付の見出しで区切らない
*/

interface Props {
	/** 項目は新しい順 */
	page: Page<Memo>;
}

const {
	page: { items: memos, page: current, pageCount },
} = Astro.props;
---

<div class="memo-page">
	<Breadcrumb ancestors={[{ href: "/", label: "HOME" }]} current="MEMOS" />

	<h1 class="text-page-title">MEMOS</h1>

	{memos.length > 0 ? (
		<ol class="list">
			{memos.map((memo) => (
				<li>
					<MemoSlip memo={memo} />
				</li>
			))}
		</ol>
	) : (
		<p class="empty">まだメモはありません。</p>
	)}

	<Pagination
		basePath="/memos"
		class="pagination"
		current={current}
		pageCount={pageCount}
	/>
</div>

<style>
.memo-page {
	display: grid;
	grid-template-columns: minmax(0, 1fr);
	row-gap: 0.75rem;
}

.list {
	display: grid;
	grid-template-columns: minmax(0, 1fr);
	margin-top: 0.5rem;
	/* 伝票の後ろに重ねた紙（右下に 16px）の分も空ける。スマホのレーンの内余白（12px）では右の溝にかかるので、右も 4px 空ける */
	row-gap: 1.5rem;
	padding: 0 0.25rem 0 0;
	list-style: none;
}

.empty {
	margin-top: 0.5rem;
	color: var(--color-ink-900);
	font-size: var(--font-size-14);
	line-height: 1.7;
}

.pagination {
	justify-self: center;
	margin-top: 1rem;
}

@media (width >= 768px) {
	.memo-page {
		row-gap: 1rem;
	}

	.list {
		grid-template-columns: repeat(2, minmax(0, 1fr));
		/* 片方の続きを開いても、隣の伝票は伸ばさない */
		align-items: start;
		gap: 1.5rem;
	}
}
</style>
