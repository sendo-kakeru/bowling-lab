---
import type { HTMLAttributes } from "astro/types";
import { FOOTER_NAV_ITEMS, SITE_TITLE, SOCIAL_LINKS } from "../consts";

type Props = HTMLAttributes<"footer">;

const { class: className, ...rest } = Astro.props;
---

<footer {...rest} class:list={["footer", className]}>
	<ul class="links">
		{
			FOOTER_NAV_ITEMS.map(({ href, label }) => (
				<li>
					<a href={href}>{label}</a>
				</li>
			))
		}
		{
			SOCIAL_LINKS.map(({ href, label }) => (
				<li>
					<a href={href}>{label}</a>
				</li>
			))
		}
	</ul>
	<p class="copyright"><small>&copy; {SITE_TITLE}</small></p>
</footer>

<style>
	.footer {
		display: grid;
		row-gap: 0.5rem;
		padding: 1rem;
		border-top: 1px solid;
	}

	.links {
		display: grid;
		grid-auto-flow: column;
		justify-content: start;
		column-gap: 1rem;
		margin: 0;
		padding: 0;
		list-style: none;
	}

	.copyright {
		margin: 0;
	}
</style>
