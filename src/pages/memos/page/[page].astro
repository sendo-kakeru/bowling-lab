---
import type { GetStaticPaths } from "astro";
import MemoList from "../../../components/MemoList.astro";
import { LIST_PER_PAGE } from "../../../consts";
import Base from "../../../layouts/Base.astro";
import { getMemos } from "../../../lib/get-memos";
import { getRestPageStaticPaths, paginate } from "../../../lib/pagination";

export const getStaticPaths = (async () => {
	const pages = paginate({ items: await getMemos(), perPage: LIST_PER_PAGE });
	return getRestPageStaticPaths({ pages });
}) satisfies GetStaticPaths;

const { page } = Astro.props;
---

<Base
	description={`メモ一覧 ${page.page} ページ目`}
	title={`メモ一覧（${page.page} ページ目）`}
>
	<MemoList page={page} />
</Base>
