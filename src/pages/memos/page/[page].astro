---
import type { GetStaticPaths } from "astro";
import MemoList from "../../../components/MemoList.astro";
import Pagination from "../../../components/Pagination.astro";
import { LIST_PER_PAGE } from "../../../consts";
import Base from "../../../layouts/Base.astro";
import { getMemos } from "../../../utils/get-memos";
import { getRestPageStaticPaths, paginate } from "../../../utils/pagination";

export const getStaticPaths = (async () => {
	const pages = paginate({ items: await getMemos(), perPage: LIST_PER_PAGE });
	return getRestPageStaticPaths({ pages });
}) satisfies GetStaticPaths;

const { page } = Astro.props;
---

<Base title={`メモ（${page.page} ページ目）`}>
	<div class="stack">
		<h1>メモ</h1>
		<MemoList memos={page.items} />
		<Pagination
			basePath="/memos"
			current={page.page}
			pageCount={page.pageCount}
		/>
	</div>
</Base>

<style>
.stack {
	display: grid;
	row-gap: 2rem;
}

h1 {
	margin: 0;
}
</style>
