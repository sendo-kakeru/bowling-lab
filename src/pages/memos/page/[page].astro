---
import type { GetStaticPaths } from "astro";
import MemoList from "../../../components/MemoList.astro";
import { LIST_PER_PAGE } from "../../../consts";
import Base from "../../../layouts/Base.astro";
import { getMemos } from "../../../utils/get-memos";
import { getRestPageStaticPaths, paginate } from "../../../utils/pagination";

export const getStaticPaths = (async () => {
	const pages = paginate({ items: await getMemos(), perPage: LIST_PER_PAGE });
	return getRestPageStaticPaths({ pages });
}) satisfies GetStaticPaths;

const { page } = Astro.props;
---

<Base
	description="記事にするほどでもない、一文だけのメモ。新しい順に並んでいます。"
	title={`MEMO（${page.page} ページ目）`}
>
	<MemoList current={page.page} memos={page.items} pageCount={page.pageCount} />
</Base>
