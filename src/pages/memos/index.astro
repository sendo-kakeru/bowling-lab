---
import MemoList from "../../components/MemoList.astro";
import { LIST_PER_PAGE } from "../../consts";
import Base from "../../layouts/Base.astro";
import { getMemos } from "../../lib/content/get-memos";
import { paginate } from "../../lib/ui/pagination";

const [page] = paginate({ items: await getMemos(), perPage: LIST_PER_PAGE });
---

<Base description="メモ一覧" title="メモ一覧">
	<MemoList page={page} />
</Base>
