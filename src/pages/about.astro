---
import { Image } from "astro:assets";
import avatar from "../assets/avatar.png";
import Breadcrumb from "../components/Breadcrumb.astro";
import Card from "../components/Card.astro";
import { INSTAGRAM_URL, SITE_AUTHOR } from "../consts";
import Base from "../layouts/Base.astro";
---

<Base description="本サイト、管理者について" title="About">
	<div class="about-page">
		<Breadcrumb items={[{ href: "/", label: "HOME" }, { label: "ABOUT" }]} />

		<!-- 見出しは記事一覧と同じく、ナビの名前としてカードに載せずレーンに直接置く -->
		<h1 class="text-page-title">ABOUT</h1>

		<Card as="article" class="about" raised>
			<div class="about-body prose text-body">
				<h2 class="sr-only">私について</h2>
				<!-- 名前がすぐ横にあるので、画像は飾りとして読み上げない -->
				<div class="profile">
					<Image
						alt=""
						class="avatar"
						densities={[1, 2]}
						loading="eager"
						src={avatar}
						width={64}
					/>
					<p class="name">{SITE_AUTHOR}</p>
				</div>
				<p>
					独学でローダウン投法を練習しています👋
					<br>
					ボウリング歴は半年ほど。Ema Iwazawa選手のフォームを目指しています。
				</p>
				<p>
					練習のためにマイボール使っていますが、ハウスボールメインで投げていきたいです。
				</p>

				<h2>このサイトについて</h2>
				<p>
					練習の中で意識していることや選手の考察などを残していきます。
					<br>
					動画投稿は
					<a href={INSTAGRAM_URL} rel="noopener noreferrer" target="_blank"
						>Instagram</a
					>にて行なっています。
				</p>
			</div>
		</Card>
	</div>
</Base>

<style>
/* パンくずとカードを本文の幅（+ カードの内余白）の列にそろえて中央に置く */
.about-page {
	--about-padding-inline: 1.25rem;

	display: grid;
	grid-template-columns: minmax(
			0,
			calc(var(--layout-content-width) + 2 * var(--about-padding-inline))
		);
	justify-content: center;
	row-gap: 0.75rem;
}

/* 記事一覧（PostList）のカードの列と同じく、見出しから少し離す */
.about {
	margin-top: 0.5rem;
}

/* 見えない見出しの後ろでも、本文（.prose）の見出しの後の間隔を空けない */
.profile {
	margin-top: 0;
	display: grid;
	grid-template-columns: auto minmax(0, 1fr);
	align-items: center;
	column-gap: 0.5rem;
}

.avatar {
	width: 4rem;
	height: auto;
	aspect-ratio: 1;
}

.name {
	color: var(--color-navy-900);
	font-family: var(--font-display);
	font-size: var(--font-size-28);
	font-weight: 700;
	letter-spacing: 0.02em;
	line-height: 1.2;
}

.about-body {
	padding: 1.5rem var(--about-padding-inline) 1.75rem;
}

@media (width >= 768px) {
	.about-page {
		--about-padding-inline: 2.25rem;

		row-gap: 1rem;
	}

	.about-body {
		padding-top: 2.75rem;
		padding-bottom: 3rem;
	}
}

@media (width >= 1024px) {
	.about-page {
		--about-padding-inline: 3rem;
	}

	.about-body {
		padding-top: 3rem;
	}
}
</style>
