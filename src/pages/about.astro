---
import Base from "../layouts/Base.astro";
import type { PageData } from "../utils/page-schema";
import { getPage } from "../utils/pages";

const { data, Content } = await getPage({ id: "about" });

const CARD_ITEMS: readonly {
	label: string;
	key: Exclude<keyof PageData<"about">["bowler"], "name">;
}[] = [
	{ key: "hand", label: "投げ方" },
	{ key: "style", label: "スタイル" },
	{ key: "ball", label: "マイボール" },
	{ key: "homeCenter", label: "ホームセンター" },
];
---

<Base title={data.title}>
	<div class="about">
		<h1>{data.title}</h1>
		<section aria-labelledby="bowler-name" class="card">
			<p class="card-label">BOWLER CARD</p>
			<h2 class="card-name" id="bowler-name">{data.bowler.name}</h2>
			<dl class="card-items">
				{CARD_ITEMS.map(({ key, label }) => (
					<div class="card-item">
						<dt>{label}</dt>
						<dd>{data.bowler[key]}</dd>
					</div>
				))}
			</dl>
		</section>
		<div class="prose">
			<Content />
		</div>
	</div>
</Base>

<style>
.about {
	display: grid;
	row-gap: 1.5rem;
}

.about h1 {
	margin: 0;
}

.card {
	display: grid;
	row-gap: 0.5rem;
	padding: 1rem;
	border: 1px solid currentcolor;
}

.card-label {
	margin: 0;
	font-size: 0.75rem;
	letter-spacing: 0.1em;
}

.card-name {
	margin: 0;
}

.card-items {
	display: grid;
	row-gap: 0.25rem;
	margin: 0;
}

.card-item {
	display: grid;
	grid-template-columns: 8rem 1fr;
	column-gap: 1rem;
}

.card-item dd {
	margin: 0;
}
</style>
