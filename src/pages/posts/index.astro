---
import Pagination from "../../components/Pagination.astro";
import PostList from "../../components/PostList.astro";
import { LIST_PER_PAGE } from "../../consts";
import Base from "../../layouts/Base.astro";
import { getPosts } from "../../utils/get-posts";
import { paginate } from "../../utils/pagination";

const [page] = paginate({ items: await getPosts(), perPage: LIST_PER_PAGE });
---

<Base title="記事">
	<div class="stack">
		<h1>記事</h1>
		<PostList headingLevel={2} posts={page.items} />
		<Pagination
			basePath="/posts"
			current={page.page}
			pageCount={page.pageCount}
		/>
	</div>
</Base>

<style>
.stack {
	display: grid;
	row-gap: 2rem;
}

h1 {
	margin: 0;
}
</style>
