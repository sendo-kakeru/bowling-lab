---
import PostList from "../../components/PostList.astro";
import { LIST_PER_PAGE } from "../../consts";
import Base from "../../layouts/Base.astro";
import { getPosts } from "../../utils/get-posts";
import { paginate } from "../../utils/pagination";

const [page] = paginate({ items: await getPosts(), perPage: LIST_PER_PAGE });
---

<Base description="すべての記事。新しい順に並んでいます。" title="記事一覧">
	<PostList current={page.page} pageCount={page.pageCount} posts={page.items} />
</Base>
