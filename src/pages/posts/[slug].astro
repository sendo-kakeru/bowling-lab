---
import { render } from "astro:content";
import type { GetStaticPaths } from "astro";
import Breadcrumb from "../../components/Breadcrumb.astro";
import Card from "../../components/Card.astro";
import JsonLd from "../../components/JsonLd.astro";
import TableOfContents from "../../components/post/TableOfContents.astro";
import { INSTAGRAM_URL, SITE_AUTHOR } from "../../consts";
import Base from "../../layouts/Base.astro";
import { getPosts } from "../../lib/content/get-posts";
import { formatDotDate, formatIsoDate } from "../../lib/date";
import { type EyecatchImage, toEyecatchImage } from "../../lib/media/media";

export const getStaticPaths = (async () => {
	const posts = await getPosts();
	// posts は新しい順なので、前（古い）の記事は 1 つ後ろ、次（新しい）の記事は 1 つ前
	return posts.map((post, i) => ({
		params: { slug: post.slug },
		props: { newer: posts[i - 1], older: posts[i + 1], post },
	}));
}) satisfies GetStaticPaths;

const { post, older, newer } = Astro.props;
const { Content } = await render(post.entry);
// 本文の最初の画像で代用したときは、同じ画像が 2 回並ぶので冒頭に出さない
const eyecatch =
	post.thumbnail.source === "frontmatter"
		? toEyecatchImage({ image: post.thumbnail.image })
		: undefined;
/**
 * アイキャッチの切り抜きごとの表示幅（下の .post-image の CSS）。wide は 768px 以上。少し大きめに見積もる。
 * Safari は sizes の min() / max() を読めず全体を 100vw として扱うので、calc() とメディア条件だけで書く
 */
const EYECATCH_SIZES = {
	narrow: "calc(91.41vw - 24px)",
	wide: "(width >= 1280px) 1056px, (width >= 1024px) calc(100vw - 200px), calc(100vw - 170px)",
} as const satisfies Record<keyof EyecatchImage, string>;
const ogImagePath = `/og/posts/${post.slug}.png`;
const url = new URL(Astro.url.pathname, Astro.site).href;
const blogPosting = {
	"@type": "BlogPosting",
	author: {
		"@type": "Person",
		name: SITE_AUTHOR,
		url: INSTAGRAM_URL,
	},
	datePublished: formatIsoDate({ date: post.publishedAt }),
	description: post.description,
	headline: post.title,
	image: new URL(ogImagePath, Astro.site).href,
	mainEntityOfPage: url,
	url,
};
---

<Base
	article={{ publishedAt: post.publishedAt }}
	description={post.description}
	ogImage={{ alt: post.title, path: ogImagePath }}
	title={post.title}
>
	<JsonLd data={blogPosting} />
	<div class="post-page">
		<Breadcrumb
			ancestors={[
				{ href: "/", label: "HOME" },
				{ href: "/posts", label: "POSTS" },
			]}
			current={post.title}
		/>

		<Card as="article" class="post" raised>
			<header class="post-header">
				<time
					class="post-date"
					datetime={formatIsoDate({ date: post.publishedAt })}
				>
					{formatDotDate({ date: post.publishedAt })}
				</time>
				<h1 class="post-title text-title">{post.title}</h1>
				{post.lead !== undefined && <p class="post-lead">{post.lead}</p>}
			</header>

			{eyecatch && (
				<picture class="post-image">
					<source
						height={eyecatch.wide.height}
						media="(width >= 768px)"
						sizes={EYECATCH_SIZES.wide}
						srcset={eyecatch.wide.srcset}
						width={eyecatch.wide.width}
					>
					<img
						alt=""
						decoding="async"
						fetchpriority="high"
						height={eyecatch.narrow.height}
						loading="eager"
						sizes={EYECATCH_SIZES.narrow}
						src={eyecatch.narrow.src}
						srcset={eyecatch.narrow.srcset}
						width={eyecatch.narrow.width}
					>
				</picture>
			)}

			<div class="post-body">
				<TableOfContents
					class="post-toc-collapsible"
					items={post.toc}
					variant="collapsible"
				/>
				<div class="post-content prose text-body">
					<Content />
				</div>
				<TableOfContents class="post-toc-side" items={post.toc} />
			</div>

			{(older || newer) && (
				<nav aria-label="前後の記事" class="post-nav">
					{older && (
						<a
							class="post-nav-link"
							data-direction="prev"
							href={`/posts/${older.slug}`}
							rel="prev"
						>
							<span class="post-nav-label text-label">
								<span aria-hidden="true">←</span> PREV FRAME
							</span>
							<span class="post-nav-title">{older.title}</span>
						</a>
					)}
					{newer && (
						<a
							class="post-nav-link"
							data-direction="next"
							href={`/posts/${newer.slug}`}
							rel="next"
						>
							<span class="post-nav-label text-label">
								NEXT FRAME <span aria-hidden="true">→</span>
							</span>
							<span class="post-nav-title">{newer.title}</span>
						</a>
					)}
				</nav>
			)}
		</Card>
	</div>
</Base>

<style>
.post-page {
	display: grid;
	row-gap: 0.75rem;
}

/* カードの左右の内余白。前後の記事も同じ値で揃える */
.post {
	--post-padding-inline: 1.25rem;
}

.post-header {
	display: grid;
	padding: 1.5rem var(--post-padding-inline) 1.25rem;
	border-bottom: 1px solid var(--color-wood-150);
}

.post-date {
	justify-self: start;
	color: var(--color-ink-600);
	font-family: var(--font-display);
	font-size: var(--font-size-15);
	font-weight: 500;
	letter-spacing: 0.08em;
	line-height: 1.4;
}

.post-title {
	margin-top: 0.75rem;
	color: var(--color-navy-900);
}

.post-lead {
	margin-top: 0.5rem;
	color: var(--color-ink-700);
	font-size: var(--font-size-15);
	line-height: 1.75;
}

/* スマホは見出しの下に端まで広げる */
.post-image img {
	width: 100%;
	aspect-ratio: 16 / 9;
	object-fit: cover;
}

.post-body {
	display: grid;
	grid-template-columns: minmax(0, 1fr);
	row-gap: 1.5rem;
	padding: 1.25rem var(--post-padding-inline) 1.75rem;
}

.post-toc-side {
	display: none;
}

/*
  前後の記事。PREV は 1 つ古い記事、NEXT は 1 つ新しい記事。スマホは縦に積み、768px 以上は 2 列。
  ホバーの面がカードの下の角からはみ出さないよう、カードと同じ角丸で切る
*/
.post-nav {
	display: grid;
	grid-template-columns: minmax(0, 1fr);
	overflow: hidden;
	border-top: 1px solid var(--color-wood-150);
	border-radius: 0 0 var(--radius-16) var(--radius-16);
}

.post-nav-link {
	display: grid;
	align-content: start;
	padding: 1rem var(--post-padding-inline);
	color: var(--color-ink-900);
	text-decoration: none;
	transition: background-color 0.15s;
}

/* 面の色で、押せる範囲を示す */
.post-nav-link:is(:hover, :focus-visible) {
	background: var(--color-wood-50);
}

/* 色の変化だけでフォーカスを示さない。リングは内側に寄せ、カードの角で切れないようにする */
.post-nav-link:focus-visible {
	outline-offset: -6px;
}

.post-nav-link + .post-nav-link {
	border-top: 1px solid var(--color-wood-150);
}

.post-nav-link[data-direction="next"] {
	text-align: right;
}

.post-nav-label {
	color: var(--color-ink-600);
	font-size: var(--font-size-14);
	font-weight: 700;
	letter-spacing: 0.14em;
}

.post-nav-title {
	font-size: var(--font-size-15);
	font-weight: 600;
	line-height: 1.75;
}

@media (width >= 768px) {
	.post-page {
		row-gap: 1rem;
	}

	.post {
		--post-padding-inline: 2.25rem;
	}

	.post-header {
		padding-top: 2.75rem;
		padding-bottom: 2rem;
	}

	.post-title {
		margin-top: 1rem;
	}

	.post-lead {
		margin-top: 0.75rem;
		font-size: var(--font-size-16);
	}

	.post-date {
		font-size: var(--font-size-16);
	}

	/* 768px 以上は見出しの中に、カードの内余白の内側で角を丸めて置く */
	.post-header:has(+ .post-image) {
		padding-bottom: 0;
		border-bottom: 0;
	}

	.post-image {
		padding: 1.5rem var(--post-padding-inline) 2rem;
		border-bottom: 1px solid var(--color-wood-150);
	}

	.post-image img {
		aspect-ratio: 5 / 2;
		border-radius: var(--radius-6);
	}

	.post-body {
		padding: 2.25rem var(--post-padding-inline) 3rem;
		/* 中央に置くと、左に寄せた見出しと本文の左端がずれるので左に寄せる */
		grid-template-columns: minmax(0, var(--layout-content-width));
	}

	.post-nav {
		grid-template-columns: repeat(2, minmax(0, 1fr));
	}

	.post-nav-link {
		padding-block: 1.25rem;
	}

	/* NEXT だけのときも右の列に置く */
	.post-nav-link[data-direction="next"] {
		grid-column: 2;
	}

	.post-nav-link + .post-nav-link {
		border-top: 0;
		border-left: 1px solid var(--color-wood-150);
	}

	.post-nav-label {
		font-size: var(--font-size-15);
	}
}

/*
  1024px 以上は 2 カラム。ノート PC で必ず 2 カラムになるよう 1024px で切り替え、1279px までは余白と目次を詰めて本文の幅を確保する。
  --post-toc-* と --post-min-padding-inline（見出し・画像・本文の左右の最小の余白）は 2 列の指定と内余白の計算の両方で使う。未定義だと両方が無効になるので必ず指定する
*/
@media (width >= 1024px) {
	.post {
		--post-padding-inline: 3rem;
		--post-min-padding-inline: 2.25rem;
		--post-toc-width: 220px;
		--post-toc-gap: 2.5rem;
	}

	.post-header {
		padding-top: 3rem;
	}

	.post-lead {
		font-size: var(--font-size-17);
	}

	/*
	  目次がない記事（見出しが 3 つ未満）も同じ 2 列にして右を空ける。
	  本文だけを中央に置くと、左に寄せた見出しと本文の左端がずれ、記事ごとに本文の位置が変わる
	*/
	.post-body {
		padding-top: 2.5rem;
		grid-template-columns: minmax(0, var(--layout-content-width)) var(
				--post-toc-width
			);
		justify-content: space-between;
		align-items: start;
		column-gap: var(--post-toc-gap);
	}

	/*
	  見出し・画像・本文を「本文 + 間 + 目次」の幅にそろえて中央に置く。余りを左右に等しく分け、タイトルの左だけが空かないようにする。
	  % はカードの中の幅
	*/
	:is(.post-header, .post-image, .post-body) {
		padding-inline: max(
			var(--post-min-padding-inline),
			calc(
				(
					100% -
					var(--layout-content-width) -
					var(--post-toc-gap) -
					var(--post-toc-width)
				) /
				2
			)
		);
	}

	.post-toc-collapsible {
		display: none;
	}

	/*
	  長い記事でも目次が見えるよう、画面の上に付いてくる。目次が画面より長いときは目次の中だけスクロールする。
	  スクロールの枠でフォーカスリングが切れないよう、内余白を足して同じだけ外へ広げる
	*/
	.post-toc-side {
		position: sticky;
		top: 1.5rem;
		display: block;
		grid-column: 2;
		grid-row: 1;
		max-height: calc(100dvh - 3rem);
		overflow-y: auto;
		margin: -0.5rem;
		padding: 0.5rem;
	}

	.post-content {
		grid-column: 1;
		grid-row: 1;
	}
}

/* 本文が上限の幅に届くので、詰めていた余白と目次を戻す。1280px で本文がちょうど 760px になる値 */
@media (width >= 1280px) {
	.post {
		--post-min-padding-inline: 3rem;
		--post-toc-width: 240px;
		--post-toc-gap: 3.5rem;
	}
}
</style>
