---
import type { GetStaticPaths } from "astro";
import PostList from "../../../components/PostList.astro";
import { LIST_PER_PAGE } from "../../../consts";
import Base from "../../../layouts/Base.astro";
import { getPosts } from "../../../lib/get-posts";
import { getRestPageStaticPaths, paginate } from "../../../lib/pagination";

export const getStaticPaths = (async () => {
	const pages = paginate({ items: await getPosts(), perPage: LIST_PER_PAGE });
	return getRestPageStaticPaths({ pages });
}) satisfies GetStaticPaths;

const { page } = Astro.props;
---

<Base
	description={`ボウリングに関する記事一覧 ${page.page} ページ目。`}
	title={`記事一覧（${page.page} ページ目）`}
>
	<PostList page={page} />
</Base>
