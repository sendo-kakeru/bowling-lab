---
import Button from "../components/Button.astro";
import Card from "../components/Card.astro";
import Base from "../layouts/Base.astro";

/*
  配信側（wrangler.jsonc の not_found_handling: "404-page"）が、無い URL に dist/404.html を返す。
  サイトマップには @astrojs/sitemap が 404 を載せない。
*/

const LANE_VIEWS = [
	{ length: 360, view: "narrow" },
	{ length: 600, view: "wide" },
] as const;

const BOARD_LINES = [40, 58, 76, 94, 112];
/** 先端の x（矢印の基準からのずれ）と y */
const ARROWS = [
	[0, 75],
	[-8, 57],
	[-8, 93],
] as const;
/** 先頭のピンからの x のずれと y */
const PINS = [
	[0, 75],
	[12, 66],
	[12, 84],
	[24, 57],
	[24, 75],
	[24, 93],
	[36, 48],
	[36, 66],
	[36, 84],
	[36, 102],
] as const;
/** ボールの中心からの x、y のずれと半径 */
const FINGER_HOLES = [
	[-3, -4, 1.6],
	[2, -5, 1.6],
	[0, 0, 1.8],
] as const;

function drawLane({ length }: { length: number }): {
	arrowX: number;
	ballX: number;
	pinX: number;
	path: string;
} {
	const x = ({ ratio }: { ratio: number }): number =>
		Math.round(length * ratio);
	const ballX = x({ ratio: 0.75 });
	return {
		arrowX: x({ ratio: 0.3 }),
		ballX,
		path: `M 20 62 C ${x({ ratio: 0.4 })} 122, ${x({ ratio: 0.48 })} 136, ${x({ ratio: 0.62 })} 139 L ${ballX - 12} 139`,
		pinX: length - 60,
	};
}
---

<Base
	description="お探しのページは見つかりませんでした。"
	noindex
	title="ページが見つかりません"
>
	<div class="error-page">
		<Card class="card" raised>
			<h1 class="title">
				<span class="code">404</span>
				<span class="label">PAGE NOT FOUND</span>
			</h1>
			<p class="lead">お探しのページは<wbr>見つかりませんでした</p>

			{LANE_VIEWS.map(({ view, length }) => {
				const lane = drawLane({ length });
				return (
					<svg
						aria-label="ピンに届かず右側の溝に落ちたボール"
						class="illustration"
						data-view={view}
						role="img"
						viewBox={`0 0 ${length} 150`}
					>
						<rect
							class="gutter-rail"
							height="22"
							rx="11"
							width={length}
							x="0"
							y="0"
						/>
						<rect class="lane" height="106" width={length} x="0" y="22" />
						<g class="boards">
							{BOARD_LINES.map((y) => (
								<line x1="0" x2={length} y1={y} y2={y} />
							))}
						</g>
						<rect
							class="gutter-rail"
							height="22"
							rx="11"
							width={length}
							x="0"
							y="128"
						/>
						<g class="arrows">
							{ARROWS.map(([dx, y]) => {
								const tip = lane.arrowX + dx;
								return (
									<polygon
										points={`${tip},${y} ${tip - 14},${y - 7} ${tip - 14},${y + 7}`}
									/>
								);
							})}
						</g>
						<path class="path" d={lane.path} />
						<circle class="ball" cx={lane.ballX} cy="139" r="10" />
						<g class="holes">
							{FINGER_HOLES.map(([dx, dy, r]) => (
								<circle cx={lane.ballX + dx} cy={139 + dy} r={r} />
							))}
						</g>
						<g class="pins">
							{PINS.map(([dx, y]) => (
								<circle cx={lane.pinX + dx} cy={y} r="6" />
							))}
						</g>
					</svg>
				);
			})}

			<p class="gutter">GUTTER</p>
			<p class="note">
				URL が間違っているか、ページが移動または削除された可能性があります。
			</p>

			<Button class="home" href="/">ホームに戻る</Button>
		</Card>
	</div>
</Base>

<style>
.error-page {
	display: grid;
}

.card {
	display: grid;
	justify-items: center;
	justify-self: center;
	width: min(100%, var(--layout-content-width));
	padding: 2rem 1.25rem;
	text-align: center;
}

.title {
	color: var(--color-navy-900);
	font-family: var(--font-display);
	font-weight: 700;
	line-height: 1;
}

.code {
	display: block;
	font-size: var(--font-size-96);
	letter-spacing: 0.02em;
	line-height: 0.85;
}

.label {
	display: block;
	margin-top: 1rem;
	font-size: var(--font-size-20);
	letter-spacing: 0.22em;
}

.lead {
	margin-top: 0.75rem;
	color: var(--color-ink-900);
	font-size: var(--font-size-17);
	font-weight: 700;
	line-height: 1.6;
	/* 狭い画面で語の途中で折れないよう、<wbr> の位置（文言の表の区切り）でだけ折る */
	word-break: keep-all;
}

.illustration {
	width: min(100%, 32.5rem);
	height: auto;
	margin-top: 1.75rem;
}

.illustration[data-view="wide"] {
	display: none;
}

/* SVG の属性には CSS 変数を書けないので、塗りはここでトークンから付ける */
.gutter-rail {
	fill: var(--color-gutter);
}

.lane {
	fill: var(--color-approach);
}

.boards {
	stroke: var(--color-lane-grain);
}

.arrows {
	fill: var(--color-wood-650);
}

.path {
	fill: none;
	stroke: var(--color-red);
	stroke-dasharray: 6 6;
	stroke-width: 2.5;
}

.ball {
	fill: var(--color-navy-900);
}

.holes {
	fill: var(--color-card);
}

.pins {
	fill: var(--color-card);
	stroke: var(--color-wood-650);
}

/* 左右の短い線は飾りなので擬似要素で描き、読み上げに出さない */
.gutter {
	display: grid;
	grid-auto-flow: column;
	align-items: center;
	column-gap: 0.75rem;
	margin-top: 0.5rem;
	color: var(--color-red);
	font-family: var(--font-display);
	font-size: var(--font-size-20);
	font-weight: 700;
	letter-spacing: 0.3em;
	line-height: 1.4;
}

.gutter::before,
.gutter::after {
	content: "";
	width: 1.75rem;
	height: 2px;
	background: var(--color-red);
}

.note {
	max-width: 30rem;
	margin-top: 1rem;
	color: var(--color-ink-700);
	font-size: var(--font-size-16);
	line-height: 1.75;
}

/* スマホでは押しやすいようカードの幅いっぱいにする */
.home {
	justify-self: stretch;
	margin-top: 1.5rem;
}

@media (width >= 768px) {
	/* デザインではレーンの上の余白が枠（PageLayout）より広い */
	.error-page {
		padding-top: 2rem;
	}

	.card {
		padding: 2.5rem 2.75rem 2.75rem;
	}

	.code {
		font-size: var(--font-size-140);
	}

	.label {
		font-size: var(--font-size-26);
	}

	.lead {
		font-size: var(--font-size-20);
	}

	.home {
		justify-self: center;
		min-width: 15rem;
	}

	.illustration[data-view="narrow"] {
		display: none;
	}

	.illustration[data-view="wide"] {
		display: block;
	}
}
</style>
