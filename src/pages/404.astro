---
import ErrorPage from "../components/ErrorPage.astro";
import Base from "../layouts/Base.astro";

/*
  配信側（wrangler.jsonc の not_found_handling: "404-page"）が、無い URL に dist/404.html を返す。
  サイトマップには @astrojs/sitemap が 404 を載せない。
*/
---

<Base
	description="お探しのページは見つかりませんでした。"
	noindex
	title="ページが見つかりません"
>
	<ErrorPage code="404" label="PAGE NOT FOUND">
		<Fragment slot="lead">お探しのページは<wbr>見つかりませんでした</Fragment>
		<Fragment slot="note">
			URL が間違っているか、ページが移動または削除された可能性があります。
		</Fragment>
	</ErrorPage>
</Base>
