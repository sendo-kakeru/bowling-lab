---
import HomeIntro from "../components/home/HomeIntro.astro";
import LatestMemos from "../components/home/LatestMemos.astro";
import LatestPosts from "../components/home/LatestPosts.astro";
import PinDeck from "../components/home/PinDeck.astro";
import JsonLd from "../components/JsonLd.astro";
import { SITE_TITLE } from "../consts";
import Base from "../layouts/Base.astro";
import { getMemos } from "../lib/content/get-memos";
import { getPosts } from "../lib/content/get-posts";

const LATEST_POST_COUNT = 3;
const LATEST_MEMO_COUNT = 2;

const latestPosts = (await getPosts()).slice(0, LATEST_POST_COUNT);
const latestMemos = (await getMemos()).slice(0, LATEST_MEMO_COUNT);
---

<Base>
	<JsonLd
		data={{
			"@type": "WebSite",
			name: SITE_TITLE,
			url: new URL("/", Astro.site).href,
		}}
	/>
	<div class="home">
		<div class="hero">
			<PinDeck />
		</div>
		<HomeIntro class="column" />
		<LatestMemos class="column" memos={latestMemos} />
		<LatestPosts posts={latestPosts} />
	</div>
</Base>

<style>
/* PinDeck のボールは画面の下からカードや区画の下をくぐってくる。
   区画ごとに位置と z-index 1 を持たせ、.hero の中で z-index 0 のボールをその下に通す。
   切り抜きはボールをレーンの外（溝、スパット、フッター）に出さないため。overflow: clip で箱ちょうどに切ると、
   伝票の後ろの紙（右下に 16px）とカードの影、奥へ滑った倒れたピンまで切れるので、その分だけ外に広げて切る */
.home {
	display: grid;
	row-gap: 2rem;
	clip-path: inset(-1rem calc(-1 * var(--layout-lane-padding)) -2.5rem);
}

.home > * {
	position: relative;
	z-index: 1;
}

/* 中身の少ないサイト説明とメモは、本文と同じ幅で中央に置く。記事の 3 列だけレーンいっぱいに使う */
.column {
	justify-self: center;
	width: 100%;
	max-width: var(--layout-content-width);
}

@media (width >= 768px) {
	.home {
		row-gap: 3rem;
	}
}
</style>
