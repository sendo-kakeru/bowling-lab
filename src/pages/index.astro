---
import MemoList from "../components/MemoList.astro";
import PostList from "../components/PostList.astro";
import { SITE_TAGLINE, SITE_TITLE } from "../consts";
import Base from "../layouts/Base.astro";
import { getMemos } from "../utils/get-memos";
import { getPosts } from "../utils/get-posts";

const LATEST_POST_COUNT = 3;
const LATEST_MEMO_COUNT = 2;

const latestPosts = (await getPosts()).slice(0, LATEST_POST_COUNT);
const latestMemos = (await getMemos()).slice(0, LATEST_MEMO_COUNT);
---

<Base>
	<div class="stack">
		<div>
			<h1>{SITE_TITLE}</h1>
			<p>{SITE_TAGLINE}</p>
		</div>
		<section aria-labelledby="latest-posts" class="stack">
			<h2 id="latest-posts">最新の記事</h2>
			<PostList headingLevel={3} posts={latestPosts} />
			<a href="/posts">記事の一覧へ</a>
		</section>
		<section aria-labelledby="latest-memos" class="stack">
			<h2 id="latest-memos">最新のメモ</h2>
			<MemoList memos={latestMemos} />
			<a href="/memos">メモの一覧へ</a>
		</section>
	</div>
</Base>

<style>
.stack {
	display: grid;
	row-gap: 2rem;
}

h1,
h2 {
	margin: 0;
}
</style>
