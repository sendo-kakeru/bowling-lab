---
import SiteHeader from "../components/header/SiteHeader.astro";
import SiteFooter from "../components/SiteFooter.astro";
import Spats from "../components/Spats.astro";

/*
  ページの枠（ヘッダー、レーン、スパット、フッター）。
  <html> と <head> を出す Base.astro と、ページの部品を枠に入れて見る Storybook の両方から使う
*/
---

<div class="page">
	<SiteHeader />
	<div class="lane">
		<main class="lane-main" id="main">
			<div>
				<slot />
			</div>
			<Spats />
		</main>
	</div>
	<SiteFooter />
</div>

<style>
/* 中身が短くてもレーンを画面の下まで伸ばす */
.page {
	display: grid;
	grid-template-rows: auto 1fr auto;
	grid-template-columns: minmax(0, 1fr);
	min-height: 100dvh;
	/* レーンの外はカーペットの色。<body> の色（Base.astro）が無い Storybook でも同じに見せる */
	background: var(--color-carpet);
}

/* ガター・板・ガターの 3 列 */
.lane {
	/* 板の部分の 4.7% で太らせ、40px で止める。% は .lane 全体の幅なので r / (1 + 2r) に直す */
	--lane-gutter: min(100% * 0.047 / (1 + 2 * 0.047), 40px);

	display: grid;
	grid-template-columns: var(--lane-gutter) minmax(0, 1fr) var(--lane-gutter);
	width: 100%;
	max-width: var(--layout-page-width);
	margin-inline: auto;
}

/* 丸く凹んだ断面に見せる */
.lane::before,
.lane::after {
	content: "";
	grid-row: 1;
	background: linear-gradient(
		90deg,
		var(--color-gutter-edge),
		var(--color-gutter) 30%,
		var(--color-gutter-highlight) 50%,
		var(--color-gutter) 70%,
		var(--color-gutter-edge)
	);
}

.lane::before {
	grid-column: 1;
}

.lane::after {
	grid-column: 3;
}

/* 実際のレーンと同じ 39 枚の板。2 枚（右端に 1px の木目）で 1 周期。
	   + 2px は、39 枚目の右端の木目をレーンの外に押し出して、ガターとの境に線を出さないため */
.lane-main {
	/* スパットは本文の終わりに付け、下はファウルラインまで広く空ける。下は外側の矢印から測る */
	--spats-gap-top: 3rem;
	--spats-gap-bottom: 10rem;

	grid-column: 2;
	grid-row: 1;
	/* 中身が短くても、スパットをフッターの直前（レーンの下端）に置く */
	display: grid;
	grid-template-rows: 1fr auto;
	/* 列を指定しないと、幅の広い中身（コードや長い URL）に合わせて列が広がり、スパットが中央からずれる */
	grid-template-columns: minmax(0, 1fr);
	row-gap: var(--spats-gap-top);
	padding: 1rem var(--layout-lane-padding) var(--spats-gap-bottom);
	background-color: var(--color-lane);
	background-image: linear-gradient(
		90deg,
		var(--color-lane-light) 0 calc(50% - 1px),
		var(--color-lane-grain) 0 50%,
		var(--color-lane-mid) 0 calc(100% - 1px),
		var(--color-lane-grain) 0 100%
	);
	background-size: calc((100% + 2px) * 2 / 39) 100%;
	background-position: 0 0;
}

@media (width >= 768px) {
	.lane-main {
		--spats-gap-top: 5rem;
		--spats-gap-bottom: 15rem;

		padding-top: 1.5rem;
	}
}
</style>
