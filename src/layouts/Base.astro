---
import { Font } from "astro:assets";
import SiteHeader from "../components/header/SiteHeader.astro";
import SiteFooter from "../components/SiteFooter.astro";
import Spats from "../components/Spats.astro";
import { SITE_LANG, SITE_TAGLINE, SITE_TITLE } from "../consts";
import layerOrder from "../styles/layers.css?raw";
import "../styles/tokens.css";
import "../styles/base.css";
import "../styles/text.css";
import "../styles/utilities.css";
import "../styles/prose.css";

/*
  全ページ共通の骨組み（<head>、ヘッダー、レーン、スパット、フッター）。
  OGP などの meta は別の issue（meta情報設定）で足す
*/

interface Props {
	/** ページの題名。省くとサイト名だけにする（ホーム用） */
	title?: string;
	description?: string;
}

const { title, description = SITE_TAGLINE } = Astro.props;

const pageTitle = title ? `${title} | ${SITE_TITLE}` : SITE_TITLE;
const canonicalUrl = new URL(Astro.url.pathname, Astro.site);
---

<!doctype html>
<html lang={SITE_LANG}>
	<head>
		<!-- レイヤーの順番は、どの CSS よりも先に宣言する -->
		<style is:inline set:html={layerOrder}></style>
		<meta charset="utf-8">
		<meta content="width=device-width,initial-scale=1" name="viewport">
		<Font cssVariable="--font-body" preload />
		<Font cssVariable="--font-display" />
		<!-- Noto Sans JP は可変フォント（太さ 400〜700 を 1 つのファイルで扱う）。理由は astro.config.mjs の fonts を参照 -->
		<link href="https://fonts.googleapis.com" rel="preconnect">
		<link crossorigin href="https://fonts.gstatic.com" rel="preconnect">
		<link
			href="https://fonts.googleapis.com/css2?family=Noto+Sans+JP:wght@400..700&display=swap"
			rel="stylesheet"
		>
		<link href="/favicon.svg" rel="icon" type="image/svg+xml">
		<link href="/favicon.ico" rel="icon">
		<link href="/sitemap-index.xml" rel="sitemap">
		<link href={canonicalUrl} rel="canonical">
		<link
			href="/rss.xml"
			rel="alternate"
			title={SITE_TITLE}
			type="application/rss+xml"
		>
		<meta content={Astro.generator} name="generator">
		<title>{pageTitle}</title>
		<meta content={description} name="description">
	</head>
	<body>
		<div class="page">
			<SiteHeader />
			<div class="lane">
				<main class="lane-main" id="main">
					<div>
						<slot />
					</div>
					<Spats />
				</main>
			</div>
			<SiteFooter />
		</div>
	</body>
</html>

<style>
/* レーンの外（ヘッダーとフッターの外、スクロールしすぎたとき）はカーペットの色 */
:global(body) {
	background: var(--color-carpet);
}

/* 中身が短くてもレーンを画面の下まで伸ばす */
.page {
	display: grid;
	grid-template-rows: auto 1fr auto;
	grid-template-columns: minmax(0, 1fr);
	min-height: 100dvh;
}

/* ガター・板・ガターの 3 列 */
.lane {
	/* 板の部分の 4.7% で太らせ、40px で止める。% は .lane 全体の幅なので r / (1 + 2r) に直す */
	--lane-gutter: min(100% * 0.047 / (1 + 2 * 0.047), 40px);

	display: grid;
	grid-template-columns: var(--lane-gutter) minmax(0, 1fr) var(--lane-gutter);
	width: 100%;
	max-width: var(--layout-page-width);
	margin-inline: auto;
}

/* 丸く凹んだ断面に見せる */
.lane::before,
.lane::after {
	content: "";
	grid-row: 1;
	background: linear-gradient(
		90deg,
		var(--color-gutter-edge),
		var(--color-gutter) 30%,
		var(--color-gutter-highlight) 50%,
		var(--color-gutter) 70%,
		var(--color-gutter-edge)
	);
}

.lane::before {
	grid-column: 1;
}

.lane::after {
	grid-column: 3;
}

/* 実際のレーンと同じ 39 枚の板。2 枚（右端に 1px の木目）で 1 周期。
	   + 2px は、39 枚目の右端の木目をレーンの外に押し出して、ガターとの境に線を出さないため */
.lane-main {
	/* スパットは本文の終わりに付け、下はファウルラインまで広く空ける。下は外側の矢印から測る */
	--spats-gap-top: 3rem;
	--spats-gap-bottom: 10rem;

	grid-column: 2;
	grid-row: 1;
	/* 中身が短くても、スパットをフッターの直前（レーンの下端）に置く */
	display: grid;
	grid-template-rows: 1fr auto;
	/* 列を指定しないと、幅の広い中身（コードや長い URL）に合わせて列が広がり、スパットが中央からずれる */
	grid-template-columns: minmax(0, 1fr);
	row-gap: var(--spats-gap-top);
	padding: 1rem var(--layout-lane-padding) var(--spats-gap-bottom);
	background-color: var(--color-lane);
	background-image: linear-gradient(
		90deg,
		var(--color-lane-light) 0 calc(50% - 1px),
		var(--color-lane-grain) 0 50%,
		var(--color-lane-mid) 0 calc(100% - 1px),
		var(--color-lane-grain) 0 100%
	);
	background-size: calc((100% + 2px) * 2 / 39) 100%;
	background-position: 0 0;
}

@media (width >= 768px) {
	.lane-main {
		--spats-gap-top: 5rem;
		--spats-gap-bottom: 15rem;

		padding-top: 1.5rem;
	}
}
</style>
